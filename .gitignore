# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenNext
/.open-next

# wrangler files
.wrangler
.dev.vars*


!.dev.vars.example

# contestation pipeline: ingested source material stays local
/pipeline/inbox/*
!/pipeline/inbox/README.md

# personal / not for the repo
/AAG BARNS 2026.pdf

# Zenodo deposit bundle — derived output, regenerate with pipeline/export-zenodo.ts
zenodo/

# This repo is PUBLIC: a commit here is a publication. Unlodged drafts,
# third-party documents we did not author, material shared with us rather than
# published, individuals' contact details, and internal QA that records which
# claims are not yet verified all stay local. Primary-source evidence from
# public registers is committed on purpose: it is the audit record.
docs/internal/
content updates/*.xlsx
content updates/senate-submission-DRAFT.md
content updates/outreach-contacts.md
