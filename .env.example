# Mapbox token used by the client to render the base map.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token

# Notion integration secret used server-side by /api/sites to read the tracker.
# Create one at https://www.notion.so/my-integrations (Internal integration),
# then share the "Critical Infrastructure Tracker" database with that integration.
NOTION_TOKEN=ntn_your_notion_integration_secret

# Optional: defaults to the Critical Infrastructure Tracker database.
NOTION_DATABASE_ID=8b537010f4cb4aa6b6df470f9d0d40c9

# --- Contestation pipeline (pipeline/) -------------------------------------
# The pipeline reuses NOTION_TOKEN above. For local runs the secrets can also
# live in ~/.config/contestation/.env and ~/.config/contestation/anthropic.env
# (chmod 600, outside the repo) — see pipeline/lib/env.ts.

# Anthropic key for the classifier (starts sk-ant-...).
ANTHROPIC_API_KEY=sk-ant-your_key

# Optional: classifier model. Defaults to claude-sonnet-4-6.
# claude-haiku-4-5-20251001 is the cheaper option for large batches.
CLASSIFIER_MODEL=claude-sonnet-4-6
